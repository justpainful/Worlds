/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://login.enterworlds.space; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
