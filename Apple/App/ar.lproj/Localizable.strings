/* Worlds Apple app strings. English text is the key. */

"AI Assistant" = "المساعد الذكي";
"Done" = "تم";
"AI settings" = "إعدادات الذكاء الاصطناعي";
"Not set up" = "غير مُعَدّ";
"Model %@. Reads page titles and previews; it cannot change your workspace yet." = "النموذج %@. يقرأ عناوين الصفحات ومعايناتها، ولا يمكنه تغيير مساحة عملك بعد.";
